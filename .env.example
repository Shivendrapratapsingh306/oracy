# Copy to .env and fill in locally. Never commit real values.

# --- General ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ACCESS_TOKEN_MINUTES=720
MAX_RESUME_UPLOAD_MB=
MAX_AUDIO_UPLOAD_MB=
MAX_VIDEO_UPLOAD_MB=

# --- Database ---
POSTGRES_USER=oracy
POSTGRES_PASSWORD=change_me_for_local_dev
POSTGRES_DB=oracy
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://oracy:change_me_for_local_dev@localhost:5432/oracy

# --- MongoDB Atlas (optional connection check; app persistence still uses PostgreSQL for now) ---
MONGODB_URI=mongodb+srv://oracy_app:<URL_ENCODED_PASSWORD>@cluster0.xgy357d.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=oracy

# --- File storage (local | s3) ---
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
S3_BUCKET_NAME=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- LLM provider (optional; leave blank to disable) ---
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# --- ML / speech / vision (optional) ---
WHISPER_MODEL_SIZE=
SENTENCE_TRANSFORMER_MODEL=
MODEL_CACHE_DIR=./models_cache

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
